# Environment variable NAMES only. Never put real values in this file.
# Real values live in Vercel project env vars (per environment) and GitHub
# secrets. See docs/STAGING_RUNBOOK.md.
#
# Local development: never point DATABASE_URL at pilot or staging while running
# tests (integration tests write fixtures). Leave it unset for unit tests.

# Database (Prisma, prisma.config.ts and src/infrastructure/prisma-runtime.ts).
# Runtime on Vercel: same Supabase pooler mode as pilot. Migrations (GitHub
# Actions, STAGING_DATABASE_URL secret): direct or session pooler (port 5432).
DATABASE_URL=

# Supabase Auth (public, browser-safe)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Auth admin (server only, never NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Meta WhatsApp Cloud API (server only)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
WHATSAPP_TEMPLATES_JSON=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

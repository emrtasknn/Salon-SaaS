# Names only. Never commit real values. Copy to .env.local and fill in locally.
# WARNING: never point DATABASE_URL at Pilot/production while running tests or migrations (see CLAUDE.md).
# Integration tests write fixtures; leave DATABASE_URL unset for unit tests.
# Deployed values live in Vercel env vars (per environment) and GitHub
# Environment secrets. See docs/STAGING_RUNBOOK.md.

# Database (Prisma / PostgreSQL; prisma.config.ts and src/infrastructure/prisma-runtime.ts)
# Runtime on Vercel: Supabase TRANSACTION pooler (port 6543) as salon_app.<ref>.
# Session mode (5432) caps clients at the pool size (15 on pilot) and serverless
# instances exhaust it (EMAXCONNSESSION). Transaction mode is safe here: tenant
# context uses transaction-local set_config(..., true) and @prisma/adapter-pg
# sends unnamed statements (do not set statementNameGenerator).
# Migrations never use the runtime URL: staging uses the GitHub Environment
# secret STAGING_DATABASE_URL (session pooler 5432 or direct).
DATABASE_URL=
# Optional: max pg connections per serverless instance (1-10, default 3).
DATABASE_POOL_MAX=

# Supabase (NEXT_PUBLIC_* are browser-safe; the service role key is server only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Meta WhatsApp Cloud API (shared platform sender, server only)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
WHATSAPP_TEMPLATES_JSON=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Rate limiting (WP-5). Server-only HMAC key, >= 32 random bytes; required in production (startup fails without it).
RATE_LIMIT_HMAC_SECRET=
# Trusted client-IP header set by the hosting platform: x-vercel-forwarded-for | x-forwarded-for | cf-connecting-ip. Unset = IP limits skipped.
# Only pick a header the platform itself overwrites: x-forwarded-for is safe on Vercel only (spoofable behind nginx/other proxies);
# cf-connecting-ip only behind Cloudflare. Recommended on Vercel: x-vercel-forwarded-for.
TRUSTED_IP_HEADER=

# Web Push (WP-09, ADR-044 §4). Server only; the public key is served at runtime by
# getWebPushConfigAction (not NEXT_PUBLIC_*). Generate with `npx web-push generate-vapid-keys`.
# Never commit real keys. Subject must be mailto:<address> or an https: URL.
# Unset = Web Push disabled (WhatsApp keeps working independently).
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id        String   @id
  slug      String   @unique
  name      String
  timezone  String
  status    TenantStatus @default(ACTIVE)
  // E.164 (e.g. +905551112233); public wa.me CTA. DB CHECK "Tenant_contactPhone_e164_check".
  contactPhone String?
  // WP-10 KVKK data-controller identity shown in the customer notice; public
  // booking form stays closed until all three are set. Trimmed/non-blank and
  // email-shape CHECKs live in migration 20261106100000_kvkk_notice_whatsapp_optin.
  legalName        String? @db.VarChar(200)
  legalAddress     String? @db.VarChar(500)
  kvkkContactEmail String? @db.VarChar(254)
  // Customer-facing salon location (separate from legalAddress) + optional maps share link.
  // Trimmed/non-blank and maps-host allowlist CHECKs live in migration 20261107100000_tenant_public_location.
  publicAddress String? @db.VarChar(300)
  mapsUrl       String? @db.VarChar(500)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profiles     Profile[]
  staff        Staff[]
  services     Service[]
  serviceCategories ServiceCategory[]
  appointments Appointment[]
  notificationDeliveries NotificationDelivery[]
  whatsappIntegrations WhatsAppIntegration[]
  memberships  TenantMembership[]
  workingHours WorkingHours[]
  customerNotes CustomerNote[]
  appointmentAccessTokens AppointmentAccessToken[]
  pushSubscriptions PushSubscription[]
  closureDates ClosureDate[]
  appointmentContacts AppointmentContact[]
}

model Profile {
  id          String   @id @default(cuid())
  tenantId    String
  displayName String
  email       String?
  phone       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  staff        Staff?
  memberships  TenantMembership[]
  appointments Appointment[] @relation("AppointmentCustomer")
  notes       CustomerNote[]
  pushSubscriptions PushSubscription[]
  closureDatesCreated ClosureDate[]
  appointmentContactOptInsRecorded AppointmentContact[] @relation("AppointmentContactOptInRecordedBy")

  @@unique([tenantId, id])
  @@index([tenantId])
  @@unique([tenantId, email])
}

enum TenantRole {
  SUPER_ADMIN
  TENANT_ADMIN
  STAFF
  CUSTOMER
}

enum StaffStatus {
  ACTIVE
  INACTIVE
}

enum TenantStatus {
  ACTIVE
  INACTIVE
}

enum AppointmentContactSource {
  PUBLIC_FORM
  STAFF
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
  COMPLETED
}

enum NotificationEventType {
  APPOINTMENT_CREATED
  APPOINTMENT_CONFIRMED
  APPOINTMENT_REJECTED
  APPOINTMENT_RESCHEDULED
}

enum NotificationChannel {
  WHATSAPP
  WEB_PUSH
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  UNKNOWN
}

model TenantMembership {
  id        String     @id @default(cuid())
  tenantId  String
  subjectId String
  profileId String
  role      TenantRole
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  profile Profile @relation(fields: [tenantId, profileId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade, map: "TenantMembership_profile_tenant_fkey")

  @@unique([tenantId, id])
  @@unique([tenantId, subjectId])
  @@index([tenantId, profileId])
}

model Staff {
  id        String      @id @default(cuid())
  tenantId  String
  profileId String      @unique
  status    StaffStatus @default(ACTIVE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  profile      Profile       @relation(fields: [tenantId, profileId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade, map: "Staff_profile_tenant_fkey")
  appointments Appointment[]
  closureDates ClosureDate[]

  @@unique([tenantId, id])
  @@unique([tenantId, profileId])
  @@index([tenantId])
}

model Service {
  id             String   @id @default(cuid())
  tenantId       String
  name           String
  durationMinutes Int
  bufferMinutes  Int      @default(0)
  active         Boolean  @default(true)
  /// Optional category of the same tenant (composite FK; NULL = "Diğer").
  categoryId     String?
  /// Optional price in kuruş (TRY minor units). NULL = price not shown.
  priceMinor     Int?
  /// true = "₺X ve üzeri" (starting price). Requires priceMinor (CHECK).
  priceIsFrom    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  category     ServiceCategory? @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade, map: "Service_category_tenant_fkey")
  appointments Appointment[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, categoryId])
}

/// Owner decision 2026-11-06: tenant-defined service groups shown on the public page.
model ServiceCategory {
  id        String   @id @default(cuid())
  tenantId  String
  name      String   @db.VarChar(60)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  services Service[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@index([tenantId])
}

model WorkingHours {
  id          String   @id @default(cuid())
  tenantId    String
  dayOfWeek   Int
  openMinute  Int
  closeMinute Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, dayOfWeek])
  @@index([tenantId])
}

// WP-08: closed date (tenant-wide when staffId is null, otherwise per staff).
// `date` is the LOCAL calendar date in the tenant's timezone (no time, no UTC
// instant). RLS (ENABLE + FORCE, 4 tenant policies) and the reason non-blank
// CHECK live in migration 20261105120000_closure_date. One tenant-wide closure
// per date is enforced in the app (Tenant FOR UPDATE + exists check), not by a
// partial index, to keep `prisma migrate diff` drift-free.
model ClosureDate {
  id                 String   @id @default(cuid())
  tenantId           String
  staffId            String?
  date               DateTime @db.Date
  reason             String?  @db.VarChar(200)
  createdByProfileId String?
  createdAt          DateTime @default(now())

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  staff     Staff?   @relation(fields: [tenantId, staffId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  createdBy Profile? @relation(fields: [tenantId, createdByProfileId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, staffId, date])
  @@index([tenantId, date])
}

model CustomerNote {
  id          String   @id @default(cuid())
  tenantId    String
  customerProfileId String
  body        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  customer  Profile @relation(fields: [tenantId, customerProfileId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, customerProfileId, createdAt])
}

model NotificationDelivery {
  id                String   @id @default(cuid())
  tenantId          String
  appointmentId     String
  eventType         NotificationEventType
  channel           NotificationChannel
  recipientProfileId String
  // '' for one-off events; a per-occurrence key for repeatable ones (APPOINTMENT_RESCHEDULED).
  eventKey          String   @default("")
  templateKey       String
  status            NotificationDeliveryStatus @default(PENDING)
  providerMessageId String?
  attemptCount      Int      @default(0)
  lastErrorCode     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  appointment Appointment @relation(fields: [tenantId, appointmentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, appointmentId, eventType, channel, recipientProfileId, eventKey], map: "NotificationDelivery_idempotency_key")
  @@index([tenantId, status, createdAt])
  @@index([providerMessageId])
}

// WP-06 / ADR-044 §5: customer status-link token. Only the SHA-256 hex hash of the
// raw token is stored. RLS (ENABLE + FORCE, 4 tenant policies) and the tokenHash
// format CHECK live in migration 20261104110000_appointment_access_token (not
// representable in Prisma schema).
model AppointmentAccessToken {
  id            String    @id @default(cuid())
  tenantId      String
  appointmentId String
  tokenHash     String
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  appointment Appointment @relation(fields: [tenantId, appointmentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, appointmentId])
  @@unique([tenantId, tokenHash])
}

// WP-10 (design A): per-appointment contact snapshot + KVKK notice record +
// WhatsApp opt-in/opt-out. Customer WhatsApp may only use this row's phone and
// only while whatsappOptIn = true AND optOutAt IS NULL. Opt-out keeps
// whatsappOptIn = true and sets optOutAt (audit trail). No IP/UA columns.
// RLS (ENABLE + FORCE, 4 tenant policies) and the format/consistency CHECKs
// live in migration 20261106100000_kvkk_notice_whatsapp_optin.
model AppointmentContact {
  id                       String                   @id @default(cuid())
  tenantId                 String
  appointmentId            String
  source                   AppointmentContactSource
  displayName              String                   @db.VarChar(160)
  email                    String?                  @db.VarChar(254)
  phone                    String?
  noticeVersion            String?                  @db.VarChar(64)
  noticeHash               String?
  noticeShownAt            DateTime?
  whatsappOptIn            Boolean                  @default(false)
  optInVersion             String?                  @db.VarChar(64)
  optInHash                String?
  optInAt                  DateTime?
  optInRecordedByProfileId String?
  optOutAt                 DateTime?
  createdAt                DateTime                 @default(now())

  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  appointment     Appointment @relation(fields: [tenantId, appointmentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  optInRecordedBy Profile?    @relation("AppointmentContactOptInRecordedBy", fields: [tenantId, optInRecordedByProfileId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, appointmentId])
}

// WP-09 / ADR-044 §4 (phase 3): Web Push subscription of a STAFF/TENANT_ADMIN
// profile, one row per (tenant, browser endpoint). endpoint/p256dh/auth are
// server-only secrets (never returned to clients or logged). Unique per tenant,
// not globally: a global unique under tenant RLS would leak cross-tenant
// existence via P2002. RLS (ENABLE + FORCE, 4 tenant policies) and the
// endpoint/key/userAgent/failureCount CHECKs live in migration
// 20261105130000_web_push_subscription (not representable in Prisma schema).
model PushSubscription {
  id            String    @id @default(cuid())
  tenantId      String
  profileId     String
  endpoint      String
  p256dh        String
  auth          String
  userAgent     String?
  failureCount  Int       @default(0)
  lastSuccessAt DateTime?
  lastFailureAt DateTime?
  lastSeenAt    DateTime  @default(now())
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  profile Profile @relation(fields: [tenantId, profileId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, endpoint])
  @@index([tenantId, profileId, revokedAt])
}

model WhatsAppIntegration {
  id            String   @id @default(cuid())
  tenantId      String
  provider      String
  phoneNumberId String
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([tenantId, id])
  @@unique([provider, phoneNumberId])
  @@index([tenantId, status])
}

model Appointment {
  id                String   @id @default(cuid())
  tenantId          String
  staffId           String
  serviceId         String
  customerProfileId String
  status            AppointmentStatus @default(PENDING)
  startAt           DateTime
  endAt             DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant          Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  staff           Staff   @relation(fields: [tenantId, staffId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade, map: "Appointment_staff_tenant_fkey")
  service         Service @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade, map: "Appointment_service_tenant_fkey")
  customerProfile Profile @relation("AppointmentCustomer", fields: [tenantId, customerProfileId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade, map: "Appointment_customer_tenant_fkey")
  notificationDeliveries NotificationDelivery[]
  accessTokens    AppointmentAccessToken[]
  contact         AppointmentContact?

  @@unique([tenantId, id])
  @@index([tenantId, startAt])
  @@index([tenantId, staffId, startAt])
  @@index([tenantId, customerProfileId, startAt])
  @@index([tenantId, staffId, status, startAt])
}
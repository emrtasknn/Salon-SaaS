generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id        String   @id
  slug      String   @unique
  name      String
  timezone  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profiles     Profile[]
  staff        Staff[]
  services     Service[]
  appointments Appointment[]
  notificationDeliveries NotificationDelivery[]
  memberships  TenantMembership[]
  workingHours WorkingHours[]
  customerNotes CustomerNote[]
}

model Profile {
  id          String   @id @default(cuid())
  tenantId    String
  displayName String
  email       String?
  phone       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  staff        Staff?
  appointments Appointment[] @relation("AppointmentCustomer")
  notes       CustomerNote[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@unique([tenantId, email])
}

enum TenantRole {
  SUPER_ADMIN
  TENANT_ADMIN
  STAFF
  CUSTOMER
}

enum StaffStatus {
  ACTIVE
  INACTIVE
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
  COMPLETED
}

enum NotificationEventType {
  APPOINTMENT_CREATED
  APPOINTMENT_CONFIRMED
  APPOINTMENT_REJECTED
}

enum NotificationChannel {
  WHATSAPP
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

model TenantMembership {
  id        String     @id @default(cuid())
  tenantId  String
  subjectId String
  profileId String
  role      TenantRole
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  profile Profile @relation(fields: [tenantId, profileId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, subjectId])
  @@index([tenantId, profileId])
}

model Staff {
  id        String      @id @default(cuid())
  tenantId  String
  profileId String      @unique
  status    StaffStatus @default(ACTIVE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  profile      Profile       @relation(fields: [tenantId, profileId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  appointments Appointment[]

  @@unique([tenantId, id])
  @@unique([tenantId, profileId])
  @@index([tenantId, status])
}

model Service {
  id             String   @id @default(cuid())
  tenantId       String
  name           String
  durationMinutes Int
  bufferMinutes  Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  appointments Appointment[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@index([tenantId])
}

model WorkingHours {
  id          String   @id @default(cuid())
  tenantId    String
  dayOfWeek   Int
  openMinute  Int
  closeMinute Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, dayOfWeek])
  @@index([tenantId])
}

model CustomerNote {
  id          String   @id @default(cuid())
  tenantId    String
  customerProfileId String
  body        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  customer  Profile @relation(fields: [tenantId, customerProfileId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, customerProfileId, createdAt])
}

model NotificationDelivery {
  id                String   @id @default(cuid())
  tenantId          String
  appointmentId     String
  eventType         NotificationEventType
  channel           NotificationChannel
  recipientProfileId String
  templateKey       String
  status            NotificationDeliveryStatus @default(PENDING)
  providerMessageId String?
  attemptCount      Int      @default(0)
  lastErrorCode     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  appointment Appointment @relation(fields: [tenantId, appointmentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, appointmentId, eventType, channel, recipientProfileId])
  @@index([tenantId, status, createdAt])
}

model Appointment {
  id                String   @id @default(cuid())
  tenantId          String
  staffId           String
  serviceId         String
  customerProfileId String
  status            AppointmentStatus @default(PENDING)
  startAt           DateTime
  endAt             DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant          Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  staff           Staff   @relation(fields: [tenantId, staffId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  service         Service @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  customerProfile Profile @relation("AppointmentCustomer", fields: [tenantId, customerProfileId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, startAt])
  @@index([tenantId, staffId, startAt])
  @@index([tenantId, customerProfileId, startAt])
  @@index([tenantId, staffId, status, startAt])
}